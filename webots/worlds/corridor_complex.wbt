#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/softbank/nao/protos/Nao.proto"

# Complex corridor with 5 corners (ported from WE_NAO_v000).
#
# A stepped hallway 1.4 m wide with five 90-degree corners (left, right, left,
# right, left) leading to a dead end marked by a red wall. Walls are 0.9 m high.
# Each leg is ~2.8 m, so every corner is blind. Side walls are at least 0.5 m from
# the sonars, above the bridge's 0.4 m forward stop, and the wall ahead at each
# corner is still over 0.5 m away at the turn point, so the robot can turn in place.
# Legs are longer than one walk_to (1.0 m max): split them and check odometry.
#
# SUCCESS: reach the red wall at the end of the north corridor without touching
# any wall and without falling.
WorldInfo {
  info [
    "Complex corridor with 5 corners"
  ]
  title "use_the_naoqi_bridge: Complex corridor with 5 corners"
  coordinateSystem "ENU"
  basicTimeStep 20
  FPS 20
  contactProperties [
    ContactProperties {
      material1 "NAO foot material"
      coulombFriction [
        7
      ]
      bounce 0.3
      bounceVelocity 0.003
    }
  ]
}
Viewpoint {
  orientation -0.243343 0.587481 0.771784 0.985144
  position -6.222 -5.962 10.31
  follow "NAO"
  followType "Tracking Shot"
  followSmoothness 0.3
}
Background {
  skyColor [
    0.17 0.2 0.25
  ]
}
DirectionalLight {
  ambientIntensity 0.65
  direction 0.4 -0.6 -1
  intensity 2.4
  castShadows TRUE
}
DirectionalLight {
  ambientIntensity 0.45
  direction -0.6 0.5 -0.8
  intensity 1.2
}
