#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/softbank/nao/protos/Nao.proto"

# Corridor with a turn (ported from WE_NAO_v000).
#
# A hallway 1.3 m wide that runs 3.4 m east, turns left, and runs another 2.8 m
# north to a dead end marked with a green panel. Walls are 0.9 m high. The turn is
# blind until the robot reaches it. The corridor is only about three robot-widths
# across, so odometry drift (walks go ~86 % of the commanded distance) matters.
# The side walls run parallel to the walk, so the sonar mostly doesn't see them
# (see Sim limits in the README): use the images.
#
# SUCCESS: reach the green end zone at the top of the north leg without wall
# contact and without falling.
WorldInfo {
  info [
    "Corridor with a turn"
  ]
  title "use_the_naoqi_bridge: Corridor with a turn"
  coordinateSystem "ENU"
  basicTimeStep 20
  FPS 20
  contactProperties [
    ContactProperties {
      material1 "NAO foot material"
      coulombFriction [
        7
      ]
      bounce 0.3
      bounceVelocity 0.003
    }
  ]
}
Viewpoint {
  orientation -0.243343 0.587482 0.771783 0.985145
  position -4.088 -4.188 5.983
  follow "NAO"
  followType "Tracking Shot"
  followSmoothness 0.3
}
Background {
  skyColor [
    0.17 0.2 0.25
  ]
}
DirectionalLight {
  ambientIntensity 0.65
  direction 0.4 -0.6 -1
  intensity 2.4
  castShadows TRUE
}
DirectionalLight {
  ambientIntensity 0.45
  direction -0.6 0.5 -0.8
  intensity 1.2
}
DEF FLOOR Solid {
  translation 0.0 0.0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.68 0.69 0.71
        roughness 0.9
        metalness 0
      }
      geometry Plane {
        size 10.0 10.0
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 10.0 10.0
  }
  locked TRUE
}
